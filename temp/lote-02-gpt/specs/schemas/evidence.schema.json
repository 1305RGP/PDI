{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdi.local/schemas/evidence.schema.json",
  "title": "Evidência de teste",
  "type": "object",
  "required": ["requirement_ref", "test_id", "evaluated_version", "environment", "result", "logs", "known_failures", "reviewer"],
  "properties": {
    "requirement_ref": {"type": "string", "minLength": 1},
    "test_id": {"type": "string", "minLength": 1},
    "evaluated_version": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "result": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "logs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "known_failures": {"type": "array", "items": {"type": "string"}},
    "reviewer": {"type": "string", "minLength": 1},
    "acceptance_decision": {"type": "string"}
  },
  "additionalProperties": true
}
