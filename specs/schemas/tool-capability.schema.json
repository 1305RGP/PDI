{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdi.local/schemas/tool-capability.schema.json",
  "title": "Registro de capacidade de ferramenta",
  "type": "object",
  "required": ["tool", "version", "capability", "permissions", "limitations", "status", "evidence_refs"],
  "properties": {
    "tool": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["CANDIDATE", "DOCUMENTED", "CONFIGURED", "TESTED", "APPROVED", "DISABLED"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
